#!/usr/bin/env bash
# aetna-public-check: monitors the public route (Cloudflare edge -> tunnel -> API).
#
# Run every 5 minutes by aetna-public-check.timer. Monitoring only: it never
# deploys, restarts or rolls back anything, so a Cloudflare or tunnel outage can't
# roll back a healthy application. Logs a warning on failure (and the tunnel
# connector's state), and a notice when the route recovers.
set -Eeuo pipefail

readonly CONFIG_FILE=${AETNA_CONFIG:-/etc/aetna/aetna.env}
readonly STATE_DIR=${AETNA_STATE_DIR:-/var/lib/aetna}
readonly FLAG="$STATE_DIR/public-check.failing"

log() {
  local -A num=([err]=3 [warning]=4 [notice]=5 [info]=6)
  if [[ -n ${JOURNAL_STREAM:-} ]]; then printf '<%s>%s\n' "${num[$1]}" "$2"; else printf '%s %s\n' "$1" "$2" >&2; fi
}

url=$(sed -n 's/^AETNA_PUBLIC_URL=//p' "$CONFIG_FILE" | tail -n1)
[[ $url == https://* ]] || { log err "AETNA_PUBLIC_URL missing or not https in $CONFIG_FILE"; exit 1; }
mkdir -p "$STATE_DIR"

if body=$(curl -fsS --max-time 15 --retry 2 --retry-delay 5 "$url/health" 2>&1) &&
  [[ $(jq -r '.status // empty' <<<"$body" 2>/dev/null) == ok ]]; then
  if [[ -e $FLAG ]]; then
    log notice "public route recovered: $url/health (failing since $(cat "$FLAG"))"
    rm -f "$FLAG"
  fi
  exit 0
fi

tunnel=$(docker inspect --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}} restarts={{.RestartCount}}' \
  aetna-cloudflared 2>/dev/null) || tunnel='container missing'
api=$(docker inspect --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' \
  aetna-api 2>/dev/null) || api='container missing'
[[ -e $FLAG ]] || date -u +%FT%TZ >"$FLAG"
log warning "public route check failed: $url/health ($(tail -n1 <<<"$body" | cut -c1-200)); cloudflared: $tunnel; api: $api"
exit 1
