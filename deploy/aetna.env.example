# Production host configuration. Install as /etc/aetna/aetna.env (root, 0644).
# Read by the updater (deploy/bin/aetna-update) and passed to Docker Compose as an
# env file. Plain KEY=value lines only. Contains no secrets: the tunnel token lives
# in /etc/aetna/tunnel-token.

# Image repository and the moving release tag the updater follows.
AETNA_IMAGE_REPO=ghcr.io/svansig/aetna-take-home
AETNA_RELEASE_TAG=production

# Host directory holding the datasets: v1/movies.db, v1/ratings.db (and v2/ later).
AETNA_DATA_DIR=/srv/aetna/data

# Application log level: fatal | error | warn | info | debug | trace | silent
AETNA_LOG_LEVEL=info

# Seconds to wait for a new container to become healthy before rolling back.
AETNA_HEALTH_TIMEOUT=120

# Public URL checked by aetna-public-check.timer (monitoring only; never rolls back).
AETNA_PUBLIC_URL=https://aetna-test.budarz.dev
