# Copy to .env for local development: `cp .env.example .env`.
# All values are optional; the defaults shown are used when a variable is unset.
# `npm run dev` / `npm start` load .env automatically (node --env-file-if-exists).

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP listener. Keep 127.0.0.1 locally; the Docker image sets HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3000

# Log verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Database paths. Relative paths resolve against the project root (not the CWD).
MOVIES_DB_PATH=db/movies.db
RATINGS_DB_PATH=db/ratings.db

# Docker Compose (compose.yaml) only: the host port bound on 127.0.0.1.
HOST_PORT=3000
